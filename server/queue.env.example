# Копия-пример. Реальный файл создаётся install_ubuntu.sh:
# /etc/edinaya-ochered/queue.env

QUEUE_DATA_DIR=/var/lib/edinaya-ochered
TICKET_APP_HOST=127.0.0.1
TICKET_APP_PORT=8000
QUEUE_ALLOWED_HOSTS=queue.example.com,127.0.0.1,localhost
OPEN_BROWSER=0
QUEUE_ADMIN_USER=queueadmin

# Должен быть длинным случайным значением.
WEBHOOK_TOKEN=CHANGE_ME

# Совместимые локальные адреса для QR-коннектора.
QUEUE_SERVER_URL=http://127.0.0.1:8000
QUEUE_API_URL=http://127.0.0.1:8000
TICKET_APP_URL=http://127.0.0.1:8000
WEBHOOK_BASE_URL=http://127.0.0.1:8000
