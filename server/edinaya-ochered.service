[Unit]
Description=Edinaya Ochered Python server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queueapp
Group=queueapp
WorkingDirectory=/opt/edinaya-ochered
EnvironmentFile=/etc/edinaya-ochered/queue.env
ExecStart=/opt/edinaya-ochered/.venv/bin/python /opt/edinaya-ochered/app.py
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
