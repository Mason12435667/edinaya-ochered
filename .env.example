# Example only. Never commit real values.

# Application
TICKET_APP_HOST=127.0.0.1
TICKET_APP_PORT=8000
QUEUE_ADMIN_USER=queueadmin
# 1 only when nginx on this server checks the login and sets
# `proxy_set_header X-Remote-User $remote_user;` Otherwise anyone can send the header.
QUEUE_TRUST_PROXY_USER=0
# Employees are created by an administrator. 1 opens /register (accounts still need approval).
QUEUE_ALLOW_SELF_REGISTRATION=0

# Generate a long random value for local/dev use.
WEBHOOK_TOKEN=change-me-use-a-random-value-at-least-32-characters

# WhatsApp runtime paths should live outside the repository.
QUEUE_WHATSAPP_AUTH_DIR=/var/lib/edinaya-ochered/whatsapp-auth
QUEUE_WHATSAPP_CLIENT_ID=ticket-prototype
TICKET_API_URL=http://127.0.0.1:8000

# Working time zone: IANA name (e.g. Europe/Moscow) or a fixed UTC offset in hours.
# QUEUE_TIMEZONE=Europe/Berlin
QUEUE_UTC_OFFSET_HOURS=5

# Public configurable profile
QUEUE_PROFILE=generic
# QUEUE_GENERIC_CONFIG=/etc/edinaya-ochered/company.json
